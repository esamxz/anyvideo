{
  "manifest_version": 3,
  "name": "Local Video Grabber",
  "version": "0.1.0",
  "description": "Detects and downloads the video playing in the current tab. 100% local — no external servers, no telemetry, no licensing.",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local Video Grabber"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
